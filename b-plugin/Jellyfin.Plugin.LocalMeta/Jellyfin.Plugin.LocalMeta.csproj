<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <AssemblyName>Jellyfin.Plugin.LocalMeta</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.LocalMeta</RootNamespace>
    <PackageId>Jellyfin.Plugin.LocalMeta</PackageId>
    <Version>0.3.0</Version>
    <Authors>LocalMeta</Authors>
    <Description>Local fallback provider for Jellyfin Person metadata (avatars + overview), designed to sit behind remote providers like MetaTube and only fill the gaps.</Description>
    <IsPackable>false</IsPackable>

    <!--
      部署策略：只把本插件自己的 dll + 必需的第三方依赖拷进 plugins 目录，
      绝不覆盖 Jellyfin 自带的 MediaBrowser.* / Jellyfin.* / Microsoft.Extensions.*。
      这些由 Jellyfin 宿主统一提供，版本必须跟宿主一致，插件自带副本反而会引出版本冲突。
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    升级提示：
    - 升 Jellyfin 大版本时，把下面 Jellyfin.Controller 的版本号一起改，
      并用 dotnet-setup/apiprobe 重新取证接口签名（见 README「随 Jellyfin 升级」）。
    - AssemblyVersion / Version 改这里，重新编译即可，不影响已保存的配置文件。
    - 10.11.6 已实测：BaseItemKind 搬到 Jellyfin.Data.Enums；
      IPluginConfiguration 已移除，改继承 BasePluginConfiguration；
      GetMetadata 签名是 (ItemInfo, IDirectoryService, CancellationToken)；
      IScheduledTask.ExecuteAsync(IProgress<double>, CancellationToken)，且必须实现 Key；
      计划任务枚举是 TaskTriggerInfoType.IntervalTrigger（不是 TaskTriggerInfo.TriggerInterval）。
  -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
  </ItemGroup>

  <!--
    Microsoft.Data.Sqlite 只用于直读直写 jellyfin.db。
    版本已对齐 Jellyfin 10.11.6 自带的 9.0.x（实测 C:\Jellyfin\Microsoft.Data.Sqlite.dll = 9.0.1125.51902），
    避免插件与宿主抢 SQLite 原生库。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <!--
    Newtonsoft.Json 仅用于 Sources/LocalMetaSources.cs 解析 gfriends_plan.json 这个外部 JSON 文件，
    与 Jellyfin 插件配置序列化无关（配置走 MediaBrowser.Model.Serialization.IXmlSerializer，即 XML）。
    Jellyfin 10.11.6 自带 13.0.4，这里只作编译期引用。
  -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- 配置页：内嵌成资源，Plugin.GetPages() 用 EmbeddedResourcePath 引用 -->
  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <!--
    Publish 之后按「白名单」清理产物。

    为什么不再用黑名单：Jellyfin.Controller 12.1.0 的依赖图比 10.11.6 大得多，
    除 MediaBrowser.* / Jellyfin.* 之外还带进来 EF Core、ICU4N（13MB）、Polly、
    Emby.Naming、J2N、NEbml 等一堆运行时 dll。这些宿主自己就有，插件目录里放副本
    会在两个 AssemblyLoadContext 里出现同一类型，轻则插件失效、重则 Jellyfin 起不来。
    黑名单按前缀删不干净（第三方依赖没有统一前缀），所以改成白名单：只留必需的。

    白名单（4+1 个文件）：
      Jellyfin.Plugin.LocalMeta.dll   插件自身
      Microsoft.Data.Sqlite.dll       直读直写 jellyfin.db
      SQLitePCLRaw.core.dll           SQLite 引擎托管封装
      SQLitePCLRaw.batteries_v2.dll   初始化 SQLitePCLRaw
      SQLitePCLRaw.provider.e_sqlite3.dll  指定 e_sqlite3 作为原生引擎

    runtimes/ 目录必须整个删掉：里面是 e_sqlite3 这类原生库，
    Jellyfin 的 PluginManager 会递归扫描插件目录下所有 .dll 当程序集加载，
    碰到原生库直接 BadImageFormatException → 整个插件被判 Malfunctioned 拒绝加载。
    （删掉后 SQLite 仍可用：Jellyfin 宿主进程已加载自己的 e_sqlite3，
      SQLitePCLRaw 的 provider 在进程内复用，已实测能正常读 javboss.db。）
  -->
  <Target Name="PrunePublishDir" AfterTargets="Publish">
    <ItemGroup>
      <KeepAssembly Include="$(PublishDir)$(AssemblyName).dll" />
      <KeepAssembly Include="$(PublishDir)Microsoft.Data.Sqlite.dll" />
      <KeepAssembly Include="$(PublishDir)SQLitePCLRaw.core.dll" />
      <KeepAssembly Include="$(PublishDir)SQLitePCLRaw.batteries_v2.dll" />
      <KeepAssembly Include="$(PublishDir)SQLitePCLRaw.provider.e_sqlite3.dll" />
      <AllAssembly Include="$(PublishDir)*.dll" />
      <AssemblyToDelete Include="@(AllAssembly)" Exclude="@(KeepAssembly)" />
    </ItemGroup>

    <Delete Files="@(AssemblyToDelete)" />
    <RemoveDir Directories="$(PublishDir)runtimes" />
    <RemoveDir Directories="$(PublishDir)runtimes" Condition="Exists('$(PublishDir)runtimes')" />

    <Message Importance="high"
             Text="[LocalMeta] 白名单清理：删除多余程序集 @(AssemblyToDelete->'%(Filename)%(Extension)', ', ')" />
    <Error Condition="!Exists('$(PublishDir)$(AssemblyName).dll')"
           Text="[LocalMeta] 致命：插件主程序集在清理后不存在，publish 失败。" />
  </Target>

</Project>
